<model>
    <mount>//OPNsense/mihomo</mount>
    <version>1.0.1</version>
    <description>Mihomo proxy configuration</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <log_level type="OptionField">
                <default>info</default>
                <Required>Y</Required>
                <OptionValues>
                    <debug>Debug</debug>
                    <info>Info</info>
                    <warning>Warning</warning>
                    <error>Error</error>
                    <silent>Silent</silent>
                </OptionValues>
            </log_level>
            <lan_api type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </lan_api>
            <!-- proxy=仅本机 socks 7890/7891；transparent=hev tun0 + PF anchor 接管 LAN 流量 -->
            <transport_mode type="OptionField">
                <default>proxy</default>
                <Required>Y</Required>
                <OptionValues>
                    <proxy>Proxy only</proxy>
                    <transparent>Transparent proxy</transparent>
                </OptionValues>
            </transport_mode>
            <lan_expose type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </lan_expose>
            <!-- 校验由 GeneralController 落盘 panel-state.env 时执行，不合法回落 mihomo；
                 不设 Required/mask，避免空值或非法值在 setNodes 阶段被直接拒绝 -->
            <lan_user type="TextField">
                <default>mihomo</default>
                <ValidationMessage>Only letters, digits and the characters . _ @ - are allowed (1-32 characters).</ValidationMessage>
            </lan_user>
        </general>
        <subscription>
            <!-- 订阅地址单一真源；面板不显示明文，仅在 GET 时返回 scheme://host/*** -->
            <url type="TextField">
                <default></default>
            </url>
            <auto_update type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </auto_update>
            <auto_interval type="OptionField">
                <default>o24h</default>
                <Required>Y</Required>
                <OptionValues>
                    <o6h>6 hours</o6h>
                    <o12h>12 hours</o12h>
                    <o24h>24 hours</o24h>
                </OptionValues>
            </auto_interval>
        </subscription>
        <customRules>
            <!-- 逐行校验与上限（200 行 / 32KB）由 custom_rules_validate.php 负责 -->
            <content type="TextField">
                <default></default>
            </content>
        </customRules>
    </items>
</model>
