#!/bin/sh

echo "===> Stopping mihomo"
service mihomo stop >/dev/null 2>&1 || true
pkill -TERM -f '/usr/local/bin/mihomo' 2>/dev/null || true
rm -f /var/run/mihomo.pid /var/run/mihomo_state.json
rm -f /usr/local/www/mihomo.php /usr/local/www/mihomo_logs.php /usr/local/www/mihomo_sub.php /usr/local/www/mihomo_sub_log.php

# 本模式从未写入 /conf/config.xml、未修改 Unbound、未添加 PF 规则，无需还原动作。
# 唯一可能的外部联动：hev-socks5-tunnel 上游若已指向本插件 socks 端口，由运维手册负责切回原核心（见 rescue.sh）。
